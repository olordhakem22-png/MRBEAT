    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>

    <script>
        const S = { tab: 'verif', theme: 'light', color: 'blue', searching: false };

        const COLORS = {
            blue:   { accent: '#1e3a8a', accentLight: '#dbeafe', accentSoft: '#eff6ff', accentHover: '#1e40af', glow: 'rgba(30, 58, 138, 0.15)' },
            gold:   { accent: '#b8860b', accentLight: '#fef3c7', accentSoft: '#fffbeb', accentHover: '#92400e', glow: 'rgba(184, 134, 11, 0.15)' },
            green:  { accent: '#047857', accentLight: '#dcfce7', accentSoft: '#f0fdf4', accentHover: '#065f46', glow: 'rgba(4, 120, 87, 0.15)' },
            purple: { accent: '#6d28d9', accentLight: '#ede9fe', accentSoft: '#faf5ff', accentHover: '#5b21b6', glow: 'rgba(109, 40, 217, 0.15)' },
            red:    { accent: '#b91c1c', accentLight: '#fee2e2', accentSoft: '#fef2f2', accentHover: '#991b1b', glow: 'rgba(185, 28, 28, 0.15)' }
        };

        // ===== INIT =====
        document.addEventListener('DOMContentLoaded', () => {
            try {
                const saved = JSON.parse(localStorage.getItem('kbase-v6') || '{}');
                if (saved.theme) S.theme = saved.theme;
                if (saved.color) S.color = saved.color;
                if (saved.tab) S.tab = saved.tab;
            } catch(e) {}

            applyAll();
            buildIndex();
            setupNav();
            handleHash();
            updateDate();

            setInterval(updateDate, 60000);

            const main = document.querySelector('.main-content');
            if (main) {
                main.addEventListener('scroll', () => {
                    const btn = document.getElementById('scrollTopBtn');
                    if (btn) btn.style.display = main.scrollTop > 300 ? 'flex' : 'none';
                }, { passive: true });
            }

            document.addEventListener('pointerdown', e => {
                const panel = document.getElementById('settingsPanel');
                if (!panel || !panel.classList.contains('open')) return;
                if (!e.target.closest('#settingsPanel') && !e.target.closest('[onclick*="toggleSettings"]')) {
                    closeSettings();
                }
            });

            document.addEventListener('keydown', e => {
                if ((e.ctrlKey || e.metaKey) && e.key === 'k') {
                    e.preventDefault();
                    const inp = document.getElementById('desktopSearchInput');
                    if (inp) inp.focus();
                    else toggleMobileSearch();
                }
                if (e.key === 'Escape') closeAll();
            });

            window.addEventListener('hashchange', handleHash);
        });

        function save() {
            try { localStorage.setItem('kbase-v6', JSON.stringify({ theme: S.theme, color: S.color, tab: S.tab })); } catch(e) {}
        }

        function updateDate() {
            const el = document.getElementById('liveDate');
            if (!el) return;
            const d = new Date();
            const days = ['الأحد', 'الإثنين', 'الثلاثاء', 'الأربعاء', 'الخميس', 'الجمعة', 'السبت'];
            const months = ['يناير', 'فبراير', 'مارس', 'أبريل', 'مايو', 'يونيو', 'يوليو', 'أغسطس', 'سبتمبر', 'أكتوبر', 'نوفمبر', 'ديسمبر'];
            el.textContent = days[d.getDay()] + ' · ' + d.getDate() + ' ' + months[d.getMonth()] + ' ' + d.getFullYear();
        }

        // ===== THEME =====
        function applyAll() {
            document.documentElement.setAttribute('data-theme', S.theme);
            applyColor();
            document.getElementById('darkToggle')?.classList.toggle('on', S.theme === 'dark');
            document.querySelectorAll('.swatch').forEach(s => {
                s.classList.toggle('active', s.dataset.color === S.color);
            });
            updateMetaTheme();
        }

        function applyColor() {
            const c = COLORS[S.color];
            document.documentElement.style.setProperty('--accent', c.accent);
            document.documentElement.style.setProperty('--accent-light', c.accentLight);
            document.documentElement.style.setProperty('--accent-soft', c.accentSoft);
            document.documentElement.style.setProperty('--accent-hover', c.accentHover);
            document.documentElement.style.setProperty('--accent-glow', c.glow);
        }

        function updateMetaTheme() {
            const meta = document.getElementById('metaTheme');
            if (meta) {
                const darkColors = { blue: '#3b82f6', gold: '#f59e0b', green: '#10b981', purple: '#a78bfa', red: '#f87171' };
                meta.setAttribute('content', S.theme === 'dark' ? darkColors[S.color] : COLORS[S.color].accent);
            }
        }

        function toggleDark() {
            S.theme = S.theme === 'light' ? 'dark' : 'light';
            applyAll(); save();
            toast(S.theme === 'dark' ? '🌙 الوضع الليلي' : '☀️ الوضع النهاري');
        }

        function setColor(c) {
            S.color = c;
            applyAll(); save();
            closeSettings();
        }

        // ===== NAVIGATION =====
        function setupNav() {
            document.getElementById('sidebarNav').addEventListener('click', e => {
                const btn = e.target.closest('[data-tab]');
                if (btn) openTab(btn.dataset.tab);
            });
        }

        function openTab(name) {
            S.tab = name;
            S.searching = false;
            document.querySelectorAll('.tab-content').forEach(t => t.classList.remove('active'));
            document.getElementById(name)?.classList.add('active');
            document.querySelectorAll('.sidebar-btn').forEach(b => b.classList.remove('active'));
            document.querySelector(`.sidebar-btn[data-tab="${name}"]`)?.classList.add('active');
            const d = document.getElementById('desktopSearchInput');
            const m = document.getElementById('mobileSearchInput');
            if (d) d.value = '';
            if (m) m.value = '';
            closeAll();
            const main = document.querySelector('.main-content');
            if (main) main.scrollTo({ top: 0, behavior: 'smooth' });
            try { window.history.pushState({tab:name}, '', '#'+name); } catch(e) {}
            save();
        }

        function handleHash() {
            const h = (location.hash || '').replace('#', '');
            const valid = ['verif','credit','cards','loans','certs','shipping','systems'];
            if (valid.includes(h) && h !== S.tab) openTab(h);
        }

        // ===== SEARCH =====
        let searchIndex = new Map();
        let searchTimer = null;

        function buildIndex() {
            searchIndex.clear();
            document.querySelectorAll('.searchable-section').forEach(s => {
                searchIndex.set(s.id, (s.textContent || '').toLowerCase());
            });
        }

        function runSearch(val) {
            const d = document.getElementById('desktopSearchInput');
            const m = document.getElementById('mobileSearchInput');
            if (d && document.activeElement !== d) d.value = val;
            if (m && document.activeElement !== m) m.value = val;
            clearTimeout(searchTimer);
            searchTimer = setTimeout(() => performSearch(val.trim().toLowerCase()), 80);
        }

        function performSearch(q) {
            const sections = document.querySelectorAll('.searchable-section');
            const buttons = document.querySelectorAll('.sidebar-btn');
            if (!q) {
                S.searching = false;
                sections.forEach(s => { s.classList.remove('active'); s.style.display = ''; });
                openTab(S.tab);
                return;
            }
            S.searching = true;
            let firstIdx = -1;
            sections.forEach((s, i) => {
                const text = searchIndex.get(s.id) || '';
                const match = text.includes(q);
                s.classList.add('active');
                s.style.display = match ? '' : 'none';
                if (match && firstIdx === -1) firstIdx = i;
            });
            buttons.forEach(b => b.classList.remove('active'));
            if (firstIdx >= 0 && buttons[firstIdx]) buttons[firstIdx].classList.add('active');
        }

        // ===== SIDEBAR =====
        function toggleSidebar() {
            document.querySelector('.sidebar-desktop')?.classList.toggle('open');
            document.getElementById('backdrop')?.classList.toggle('open');
        }

        function closeAll() {
            document.querySelector('.sidebar-desktop')?.classList.remove('open');
            document.getElementById('backdrop')?.classList.remove('open');
            document.getElementById('mobileSearch')?.classList.remove('open');
            closeSettings();
        }

        // ===== MOBILE SEARCH =====
        function toggleMobileSearch() {
            const ms = document.getElementById('mobileSearch');
            ms?.classList.toggle('open');
            if (ms?.classList.contains('open')) {
                setTimeout(() => document.getElementById('mobileSearchInput')?.focus(), 300);
            } else {
                const m = document.getElementById('mobileSearchInput');
                const d = document.getElementById('desktopSearchInput');
                if (m) m.value = '';
                if (d) d.value = '';
                performSearch('');
            }
        }

        // ===== SETTINGS =====
        function toggleSettings(e) {
            if (e) { e.stopPropagation(); e.preventDefault(); }
            const panel = document.getElementById('settingsPanel');
            if (!panel) return;
            if (panel.classList.contains('open')) { closeSettings(); return; }
            const btn = (e && e.currentTarget) || document.querySelector('[onclick*="toggleSettings"]');
            if (btn) {
                const r = btn.getBoundingClientRect();
                const isRTL = document.documentElement.dir === 'rtl';
                const pw = 320, ph = panel.offsetHeight || 360;
                const margin = 12;
                let top = r.bottom + 8;
                let left = isRTL ? r.right - pw : r.left;
                if (top + ph > window.innerHeight - margin) top = Math.max(margin, r.top - ph - 8);
                if (left < margin) left = margin;
                if (left + pw > window.innerWidth - margin) {
                    // Anchor to right edge of viewport in RTL (left in LTR)
                    if (isRTL) {
                        panel.style.right = margin + 'px';
                        panel.style.left = 'auto';
                        panel.style.top = top + 'px';
                        panel.classList.add('open');
                        return;
                    } else {
                        left = window.innerWidth - pw - margin;
                    }
                }
                panel.style.top = top + 'px';
                if (isRTL) { panel.style.right = left + 'px'; panel.style.left = 'auto'; }
                else { panel.style.left = left + 'px'; panel.style.right = 'auto'; }
            }
            panel.classList.add('open');
        }

        function closeSettings() {
            document.getElementById('settingsPanel')?.classList.remove('open');
        }

        function scrollToTop() {
            const main = document.querySelector('.main-content');
            if (main) main.scrollTo({ top: 0, behavior: 'smooth' });
        }

        // ===== PDF =====
        function exportPDF() {
            if (typeof html2pdf === 'undefined') { toast('⚠️ جاري التحميل...'); return; }
            toast('📄 جاري التصدير...');
            closeAll();
            const main = document.querySelector('.main-content');
            const sb = document.querySelector('.sidebar-desktop');
            const mh = document.querySelector('.mobile-header');
            const dh = document.querySelector('.desktop-header');
            const fab = document.getElementById('fabGroup');
            [sb, mh, dh, fab].forEach(el => { if (el) el.style.visibility = 'hidden'; });
            const opt = {
                margin: 8, filename: 'kbase-b042.pdf',
                image: { type: 'jpeg', quality: 0.95 },
                html2canvas: { scale: 2, useCORS: true, backgroundColor: '#ffffff' },
                jsPDF: { unit: 'mm', format: 'a4', orientation: 'portrait' },
                pagebreak: { mode: ['avoid-all', 'css', 'legacy'] }
            };
            html2pdf().set(opt).from(main).save().then(() => {
                [sb, mh, dh, fab].forEach(el => { if (el) el.style.visibility = ''; });
                toast('✅ تم تصدير PDF');
            }).catch(() => {
                [sb, mh, dh, fab].forEach(el => { if (el) el.style.visibility = ''; });
                toast('❌ فشل التصدير');
            });
        }

        // ===== TOAST =====
        let toastTimer = null;
        function toast(msg) {
            const t = document.getElementById('toast');
            if (!t) return;
            t.textContent = msg;
            t.classList.add('show');
            clearTimeout(toastTimer);
            toastTimer = setTimeout(() => t.classList.remove('show'), 2500);
        }
    </script>
</body>
</html>
